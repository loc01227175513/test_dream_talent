  {
   "id": "F-01",
   "label": "Danh sách mua bán",
   "type": "feature",
   "desc": "Lọc theo loại (căn hộ, nhà hẻm, mặt tiền, đất), khu vực, giá; badge \"Tin xác thực\", \"Tin có video\"; xem dạng list/lưới (nguồn: /mua-ban-nha-dat)"
  },
  {
   "id": "F-02",
   "label": "Danh sách cho thuê",
   "type": "feature",
   "desc": "9 loại: phòng trọ, căn hộ, nhà, CHDV, mặt bằng, văn phòng, kho xưởng, đất (nguồn: /cho-thue-nha-dat)"
  },
  {
   "id": "F-03",
   "label": "Tìm với AI",
   "type": "feature",
   "desc": "Tìm kiếm ngôn ngữ tự nhiên (\"Cơ bản\" / \"Tìm với AI\") (nguồn: /)"
  },
  {
   "id": "F-04",
   "label": "Bản đồ BĐS",
   "type": "feature",
   "desc": "Giá trên từng ghim, vẽ vùng để tìm (nguồn: /mua-ban-nha-dat?xem=ban-do)"
  },
  {
   "id": "F-05",
   "label": "Trang SEO theo khu vực",
   "type": "feature",
   "desc": "Landing page theo tỉnh/quận/phường (`/ban-nha-quan-1-...`) (nguồn: /)"
  },
  {
   "id": "F-06",
   "label": "Chi tiết tin đăng",
   "type": "feature",
   "desc": "Ảnh, giá, giá/m², diện tích, tầng, PN/WC, địa chỉ (nguồn: listing pages)"
  },
  {
   "id": "F-07",
   "label": "Tra cứu & so sánh dự án",
   "type": "feature",
   "desc": "Lọc theo pháp lý, tiến độ, chủ đầu tư; so sánh dự án (nguồn: /tim-kiem-du-an, /so-sanh-du-an)"
  },
  {
   "id": "F-08",
   "label": "Nguồn nhà đặc biệt (MOSO Signature)",
   "type": "feature",
   "desc": "BĐS đấu giá, phát mãi từ ngân hàng & Thi Hành Án, rẻ hơn 20–60% (nguồn: /nguon-nha-dac-biet)"
  },
  {
   "id": "F-09",
   "label": "Yêu cầu xem nhà / tư vấn",
   "type": "feature",
   "desc": "Để lại tên + SĐT; chuyên viên gọi lại; chống trùng 24h (nguồn: llms.txt (contact API))"
  },
  {
   "id": "F-10",
   "label": "Đăng tin bán / cho thuê với AI",
   "type": "feature",
   "desc": "AI viết tiêu đề + mô tả trong ~30 giây; form riêng cho bán/thuê (nguồn: /dang-tin, /dang-tin-ban-nha-dat, /dang-tin-cho-thue)"
  },
  {
   "id": "F-11",
   "label": "Quản lý \"Tin của tôi\"",
   "type": "feature",
   "desc": "Sửa, cập nhật giá, đánh dấu đã bán/thuê, ẩn tin, gia hạn tự động (nguồn: /dang-tin-cho-thue, /mine)"
  },
  {
   "id": "F-12",
   "label": "Đẩy tin",
   "type": "feature",
   "desc": "8h (5k), 24h + nhãn Hot (10k), 7 ngày (50k); khu vực hoặc toàn tỉnh; tối đa 3 lượt/tin/ngày (nguồn: /bang-gia-dang-tin)"
  },
  {
   "id": "F-13",
   "label": "Xoá watermark ảnh bằng AI",
   "type": "feature",
   "desc": "≤20 ảnh/lần, ≤10MB, PNG/JPG/WEBP; tô để xoá chỗ sót; versioning; tải ZIP (nguồn: /cong-cu/chinh-anh-bds)"
  },
  {
   "id": "F-14",
   "label": "Ký gửi / Nhà cần bán nhanh",
   "type": "feature",
   "desc": "Chủ nhà ký gửi, môi giới nhận bán hưởng hoa hồng (nguồn: /nha-dat-can-ban-nhanh)"
  },
  {
   "id": "F-15",
   "label": "Xác thực tin đăng",
   "type": "feature",
   "desc": "Kiểm tra ảnh, pháp lý, chính chủ → badge \"xác thực\", giảm phí 8→5 MP (nguồn: llms.txt, /bang-gia-dang-tin)"
  },
  {
   "id": "F-16",
   "label": "Ẩn số nhà",
   "type": "feature",
   "desc": "Che địa chỉ chi tiết, chỉ hiện cho khách có nhu cầu thật đã xác thực; 5 MP/30 ngày (nguồn: /dang-tin, /bang-gia-dang-tin)"
  },
  {
   "id": "F-17",
   "label": "Ví MOSO Points",
   "type": "feature",
   "desc": "1 MP = 1.000đ, đã gồm VAT; gói nạp từ 50.000đ; tự trừ khi gia hạn, thiếu points → ẩn số liên hệ (nguồn: /chinh-sach-moso-points)"
  },
  {
   "id": "F-18",
   "label": "Kiếm points miễn phí",
   "type": "feature",
   "desc": "Quà chào mừng (+30 / +100 môi giới), điểm danh +1/ngày, nhiệm vụ hồ sơ, mốc tin xác thực, mốc follower (nguồn: /chinh-sach-moso-points)"
  },
  {
   "id": "F-19",
   "label": "Đăng ký môi giới",
   "type": "feature",
   "desc": "Tạo tài khoản bằng SĐT + OTP; hồ sơ khu vực hoạt động; admin duyệt quyền nâng cao (nguồn: /register-agent, /dang-ky-moi-gioi)"
  },
  {
   "id": "F-20",
   "label": "Danh bạ môi giới & MOSO Score",
   "type": "feature",
   "desc": "Xếp hạng theo 6 yếu tố (hồ sơ, tin xác thực, review, Partner +10đ, tương tác, chứng chỉ) (nguồn: /danh-ba-moi-gioi-bat-dong-san)"
  },
  {
   "id": "F-21",
   "label": "MOSO Partner (cá nhân / doanh nghiệp)",
   "type": "feature",
   "desc": "Tặng tới 1.000 points, kho hàng ngân hàng, giảm học phí 20/30%; DN được website + quản trị + đồng bộ tin 0đ (nguồn: /moso-partner, /doi-tac-*)"
  },
  {
   "id": "F-22",
   "label": "Khóa học chứng chỉ môi giới",
   "type": "feature",
   "desc": "8 buổi, MOSO × IEM, 1.990K cho Partner (nguồn: /khoa-hoc-chung-chi-moi-gioi)"
  },
  {
   "id": "F-23",
   "label": "Cộng tác viên giới thiệu",
   "type": "feature",
   "desc": "E-voucher 100k/nguồn nhà bán hoặc khách, 10k/nguồn thuê; theo dõi realtime (nguồn: /cong-tac-vien)"
  },
  {
   "id": "F-24",
   "label": "Workshop / sự kiện",
   "type": "feature",
   "desc": "Đăng ký sự kiện đối tác (nguồn: /moso-partner-workshop)"
  },
  {
   "id": "F-25",
   "label": "Vay thế chấp",
   "type": "feature",
   "desc": "So sánh lãi suất 13+ ngân hàng, đăng ký hỗ trợ hồ sơ A-Z (nguồn: /vay-the-chap)"
  },
  {
   "id": "F-26",
   "label": "Bộ tính vay",
   "type": "feature",
   "desc": "Khả năng mua tối đa, DTI (ngưỡng 50%), lịch trả góp (dư nợ giảm dần / trả đều) (nguồn: /cong-cu/vay-mua-nha)"
  },
  {
   "id": "F-27",
   "label": "Định giá & cầm cố",
   "type": "feature",
   "desc": "Giá trị theo giá/m² khu vực ±10%, hạn mức vay từng ngân hàng (nguồn: /cong-cu/dinh-gia-cam-co-bat-dong-san)"
  },
  {
   "id": "F-28",
   "label": "Thuế & chi phí giao dịch",
   "type": "feature",
   "desc": "TNCN 2%, trước bạ 0,5%, công chứng ~0,1%; tách bên mua/bán; tiện ích Chrome/Firefox (nguồn: /cong-cu/tinh-thue-giao-dich-bds)"
  },
  {
   "id": "F-29",
   "label": "Bảng giá đất nhà nước",
   "type": "feature",
   "desc": "Tra theo tỉnh/huyện/xã/đường; báo \"chưa có dữ liệu\" thay vì ước lượng (nguồn: /cong-cu/bang-gia-dat-nha-nuoc)"
  },
  {
   "id": "F-30",
   "label": "Chuyển mục đích sử dụng đất",
   "type": "feature",
   "desc": "Theo NĐ 103/2024; tách 5 khoản chi phí (nguồn: /cong-cu/chuyen-muc-dich-su-dung-dat)"
  },
  {
   "id": "F-31",
   "label": "Thuê hay mua",
   "type": "feature",
   "desc": "Chi phí ròng N năm, chi phí cơ hội (nguồn: /cong-cu/thue-hay-mua-nha)"
  },
  {
   "id": "F-32",
   "label": "Lợi nhuận đầu tư",
   "type": "feature",
   "desc": "Cho thuê (gross/net yield) + flip (ROI quy năm) (nguồn: /cong-cu/loi-nhuan-dau-tu-bds)"
  },
  {
   "id": "F-33",
   "label": "Hiệu quả đầu tư",
   "type": "feature",
   "desc": "So sánh BĐS/ngân hàng/chứng khoán/vàng; ROI farmstay (nguồn: /cong-cu/hieu-qua-dau-tu)"
  },
  {
   "id": "F-34",
   "label": "Nên mua hay chờ",
   "type": "feature",
   "desc": "Điểm 0–100: giá khu vực 40 + lãi suất 40 + DTI 20 → MUA/CÂN NHẮC/CHỜ (nguồn: /cong-cu/nen-mua-nha-hay-cho)"
  },
  {
   "id": "F-35",
   "label": "Check quy hoạch",
   "type": "feature",
   "desc": "*Sắp ra mắt* (nguồn: /cong-cu)"
  },
  {
   "id": "F-36",
   "label": "Báo cáo thị trường",
   "type": "feature",
   "desc": "Theo tháng/quý/năm; lệch cung–cầu theo khu vực; số liệu cập nhật mỗi giờ (nguồn: /bao-cao-thi-truong-bds)"
  },
  {
   "id": "F-37",
   "label": "Tin tức & Wiki BĐS",
   "type": "feature",
   "desc": "Bài viết, thuật ngữ pháp lý (21 thuật ngữ), tiêu chuẩn biên tập, trang tác giả (E-E-A-T) (nguồn: /tin-tuc-bat-dong-san, /thuat-ngu-bat-dong-san)"
  },
  {
   "id": "F-38",
   "label": "Video nhà đất",
   "type": "feature",
   "desc": "Mục video trên menu (nguồn: /)"
  },
  {
   "id": "F-39",
   "label": "Đoán giá nhà đất",
   "type": "feature",
   "desc": "5 câu × 20s, 5 lượt/ngày, điểm theo sai lệch; Top 3 tháng nhận 200/100/50 points (≥1000 điểm) (nguồn: /doan-gia-nha-dat)"
  },
  {
   "id": "F-40",
   "label": "Tử vi & Phong thủy AI",
   "type": "feature",
   "desc": "Phong thuỷ theo mệnh/hướng, xem ngày, tarot, thần số học (nguồn: /tu-vi-phong-thuy)"
  },
  {
   "id": "F-41",
   "label": "Đăng nhập / tài khoản",
   "type": "feature",
   "desc": "Đăng nhập SĐT + OTP, hồ sơ, tin nhắn (nguồn: /register-agent, header)"
  },
  {
   "id": "F-42",
   "label": "Xoá tài khoản",
   "type": "feature",
   "desc": "3 bước trong app (nguồn: /huong-dan-xoa-tai-khoan)"
  },
  {
   "id": "F-43",
   "label": "Trợ giúp & phản ánh",
   "type": "feature",
   "desc": "Trung tâm trợ giúp, tiếp nhận phản ánh, cơ chế giải quyết tranh chấp (nguồn: /tro-giup, footer)"
  },
  {
   "id": "F-44",
   "label": "Ứng dụng mobile",
   "type": "feature",
   "desc": "iOS + Android (nguồn: /tai-ung-dung)"
  },
  {
   "id": "F-45",
   "label": "MCP server",
   "type": "feature",
   "desc": "Streamable HTTP, không cần auth; tools: search_listings, compare_listings, read_page, search_projects, search_agents, request_contact (nguồn: /.well-known/mcp.json)"
  },
  {
   "id": "F-46",
   "label": "Agent REST API",
   "type": "feature",
   "desc": "/api/agent/search, compare, projects, agents, contact; JSON/markdown; rate limit theo IP (nguồn: llms.txt)"
  },
  {
   "id": "F-47",
   "label": "Markdown content negotiation",
   "type": "feature",
   "desc": "`Accept: text/markdown` trên mọi trang, `/api/markdown?path=` (giảm ~97% token) (nguồn: llms.txt)"
  },
